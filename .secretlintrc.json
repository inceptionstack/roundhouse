{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-slack",
          "options": {
            "allows": [
              "/^(xox[a-z]|xapp)-[a-z-]+$/",
              "/^xapp-1-A0123456789-1234567890-/",
              "/^xapp-1-A1-1-[a-z]+$/",
              "/^xapp-N-AXXXX-/",
              "/^xoxb-12345678-90ABCDEF-rest1234$/",
              "/^xoxb-99999-99999-/"
            ]
          }
        }
      ]
    }
  ]
}
