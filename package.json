{
  "name": "@inceptionstack/roundhouse",
  "version": "0.7.0",
  "type": "module",
  "description": "Multi-platform chat gateway that routes messages through a configured AI agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inceptionstack/roundhouse.git"
  },
  "keywords": [
    "chat",
    "gateway",
    "telegram",
    "slack",
    "discord",
    "ai",
    "agent",
    "pi",
    "bot"
  ],
  "bin": {
    "roundhouse": "bin/roundhouse.mjs"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "files": [
    "src/",
    "bin/",
    "skills/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "architecture.md",
    "pi/"
  ],
  "dependencies": {
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/state-memory": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "chat": "4.45.0",
    "croner": "^11.0.0",
    "p-queue": "^10.0.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "^26.6.6",
    "husky": "9.1.7",
    "secretlint": "13.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
